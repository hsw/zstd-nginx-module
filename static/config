ngx_feature_incs="#include <zstd.h>"
ngx_feature_test="(void) ZSTD_createCCtx();"
ngx_feature_libs=
ngx_feature_run=yes

ngx_zstd_opt_I=
ngx_zstd_opt_L=

if [ -n "$ZSTD_INC" -o -n "$ZSTD_LIB" ]; then
    ngx_feature_path=$ZSTD_INC
    ngx_zstd_opt_I="-I$ZSTD_INC -DZSTD_STATIC_LINKING_ONLY"

    if [ "$ngx_module_link" = DYNAMIC ]; then
        # --add-dynamic-module build: distro libzstd.a is almost never built
        # with -fPIC, so linking it into a .so fails with R_X86_64_PC32
        # relocation errors. Only try the shared library — fail fast if not
        # present rather than silently producing a broken .so.
        ngx_feature="ZStandard dynamic library in $ZSTD_INC and $ZSTD_LIB"
        ngx_zstd_opt_L="-L$ZSTD_LIB -lzstd -Wl,-rpath,$ZSTD_LIB"

        SAVED_CC_TAST_FLAGS=$CC_TEST_FLAGS
        CC_TEST_FLAGS="$ngx_zstd_opt_I $CC_TEST_FLAGS"
        SAVED_NGX_TEST_LD_OPT=$NGX_TEST_LD_OPT
        NGX_TEST_LD_OPT="$ngx_zstd_opt_L $NGX_TEST_LD_OPT"

        . auto/feature

        # restore
        CC_TEST_FLAGS=$SAVED_CC_TAST_FLAGS
        NGX_TEST_LD_OPT=$SAVED_NGX_TEST_LD_OPT

        if [ $ngx_found = no ]; then
            cat << END
            $0: error: ngx_http_zstd_static_module (--add-dynamic-module) requires the ZStandard shared library, please be sure that "\$ZSTD_INC" and "\$ZSTD_LIB" are set correctly and that libzstd.so is present.
END
            exit 1
        fi
    else
        # static --add-module build: try the static archive first (so the
        # final nginx binary has no libzstd.so runtime dep), fall back to
        # the shared library.
        ngx_feature="ZStandard static library in $ZSTD_INC and $ZSTD_LIB"
        ngx_zstd_opt_L="$ZSTD_LIB/libzstd.a"
        SAVED_CC_TAST_FLAGS=$CC_TEST_FLAGS
        CC_TEST_FLAGS="$ngx_zstd_opt_I $CC_TEST_FLAGS"
        SAVED_NGX_TEST_LD_OPT=$NGX_TEST_LD_OPT
        NGX_TEST_LD_OPT="$ngx_zstd_opt_L $NGX_TEST_LD_OPT"

        . auto/feature

        # restore
        CC_TEST_FLAGS=$SAVED_CC_TAST_FLAGS
        NGX_TEST_LD_OPT=$SAVED_NGX_TEST_LD_OPT

        if [ $ngx_found = no ]; then
            # then try the dynamic shared library
            ngx_feature="ZStandard dynamic library in $ZSTD_INC and $ZSTD_LIB"
            ngx_zstd_opt_L="-L$ZSTD_LIB -lzstd -Wl,-rpath,$ZSTD_LIB"

            SAVED_CC_TAST_FLAGS=$CC_TEST_FLAGS
            CC_TEST_FLAGS="$ngx_zstd_opt_I $CC_TEST_FLAGS"
            SAVED_NGX_TEST_LD_OPT=$NGX_TEST_LD_OPT
            NGX_TEST_LD_OPT="$ngx_zstd_opt_L $NGX_TEST_LD_OPT"

            . auto/feature

            # restore
            CC_TEST_FLAGS=$SAVED_CC_TAST_FLAGS
            NGX_TEST_LD_OPT=$SAVED_NGX_TEST_LD_OPT

            if [ $ngx_found = no ]; then
                cat << END
            $0: error: ngx_http_zstd_static_module requires the ZStandard library, please be sure that "\$ZSTD_INC" and "\$ZSTD_LIB" are set correctly.
END
                exit 1
            fi
        fi
    fi
else
    # auto-discovery: prefer shared libzstd (required for --add-dynamic-module;
    # static linking of libzstd.a into a .so typically fails without -fPIC archives).
    # ZSTD_STATIC_LINKING_ONLY is purely a header visibility gate (not a link
    # mode) — needed because the filter module uses ZSTD_createCStream_advanced
    # / ZSTD_createCDict_byReference / ZSTD_customMem which live in the
    # experimental section of zstd.h.
    ngx_feature="ZStandard dynamic library"
    ngx_zstd_opt_I="-DZSTD_STATIC_LINKING_ONLY"
    ngx_zstd_opt_L="-lzstd"

    SAVED_CC_TAST_FLAGS=$CC_TEST_FLAGS
    CC_TEST_FLAGS="$ngx_zstd_opt_I $CC_TEST_FLAGS"
    SAVED_NGX_TEST_LD_OPT=$NGX_TEST_LD_OPT
    NGX_TEST_LD_OPT="$ngx_zstd_opt_L $NGX_TEST_LD_OPT"

    . auto/feature

    # restore
    CC_TEST_FLAGS=$SAVED_CC_TAST_FLAGS
    NGX_TEST_LD_OPT=$SAVED_NGX_TEST_LD_OPT

    if [ $ngx_found = no -a "$ngx_module_link" != DYNAMIC ]; then
        # fall back to static archive only for static (--add-module) builds;
        # dynamic modules must link the shared library.
        ngx_feature="ZStandard static library"
        ngx_zstd_opt_I="-DZSTD_STATIC_LINKING_ONLY"
        ngx_zstd_opt_L="-l:libzstd.a"

        SAVED_CC_TAST_FLAGS=$CC_TEST_FLAGS
        CC_TEST_FLAGS="$ngx_zstd_opt_I $CC_TEST_FLAGS"
        SAVED_NGX_TEST_LD_OPT=$NGX_TEST_LD_OPT
        NGX_TEST_LD_OPT="$ngx_zstd_opt_L $NGX_TEST_LD_OPT"

        . auto/feature

        # restore
        CC_TEST_FLAGS=$SAVED_CC_TAST_FLAGS
        NGX_TEST_LD_OPT=$SAVED_NGX_TEST_LD_OPT
    fi

    if [ $ngx_found = no ]; then
        cat << END
        $0: error: ngx_http_zstd_static_module requires the ZStandard library.
END
        exit 1
    fi

    # TODO we need more tries for the different OS port.
fi

CFLAGS="$ngx_zstd_opt_I $CFLAGS"
NGX_LD_OPT="$ngx_zstd_opt_L $NGX_LD_OPT"

# build the ngx_http_zstd_static_module
HTTP_ZSTD_SRCS="$ngx_addon_dir/static/ngx_http_zstd_static_module.c"

ngx_addon_name=ngx_http_zstd_static_module
ngx_module_type=HTTP
ngx_module_name=ngx_http_zstd_static_module
ngx_module_incs="$ngx_zstd_opt_I"
ngx_module_srcs=$HTTP_ZSTD_SRCS
# Module-order: zstd_static wins over brotli_static / gzip_static when a
# resource has multiple precompressed sidecars and the client accepts more
# than one encoding. Closes upstream tokers/zstd-nginx-module#40 (mklooss).
#
# ngx_module_order semantics: the first name comes BEFORE the rest in the
# generated ngx_modules[] array. nginx reverses content-phase handlers in
# ngx_http_init_phase_handlers (src/http/ngx_http.c:551) — LIFO chain —
# so a module at a HIGHER ngx_modules[] index has its handler called
# FIRST at request time. To make zstd_static win we therefore need it at
# the END of this list, after every static-module sibling that might
# otherwise outrank it.
ngx_module_order="ngx_http_static_module \
                  ngx_http_gzip_static_module \
                  ngx_http_brotli_static_module \
                  $ngx_module_name"

. auto/module

if [ "$ngx_module_link" != DYNAMIC ]; then
    # ngx_module_order doesn't work with static modules (only honoured for
    # --add-dynamic-module builds), so we must reorder HTTP_MODULES here.
    # Mirror filter/config:131 pattern: pick the next module by precedence
    # so the source-list order ends up as zstd_static before brotli_static
    # / gzip_static — nginx wraps content handlers in LIFO order, so a later
    # source-list entry runs earlier in the runtime chain.
    if echo $HTTP_MODULES | grep ngx_http_brotli_static_module >/dev/null; then
        next=ngx_http_brotli_static_module
    elif echo $HTTP_MODULES | grep ngx_http_gzip_static_module >/dev/null; then
        next=ngx_http_gzip_static_module
    else
        next=ngx_http_static_module
    fi

    HTTP_MODULES=`echo $HTTP_MODULES \
                  | sed "s/$ngx_module_name//" \
                  | sed "s/$next/$next $ngx_module_name/"`
fi
