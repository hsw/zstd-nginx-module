# ngx_http_zstd_static_module serves precompressed .zst sidecar files from
# disk. It includes no zstd header and uses no zstd symbol, so it needs no
# libzstd at build or run time — no feature probe, no include paths, no libs.

# The module source must resolve for BOTH add layouts: sourcing via the root
# config (--add-dynamic-module=<repo>, ngx_addon_dir = repo root) and adding
# this subdirectory directly (--add-dynamic-module=<repo>/static,
# ngx_addon_dir = .../static).
if [ -f "$ngx_addon_dir/ngx_http_zstd_static_module.c" ]; then
    HTTP_ZSTD_SRCS="$ngx_addon_dir/ngx_http_zstd_static_module.c"
else
    HTTP_ZSTD_SRCS="$ngx_addon_dir/static/ngx_http_zstd_static_module.c"
fi

ngx_addon_name=ngx_http_zstd_static_module
ngx_module_type=HTTP
ngx_module_name=ngx_http_zstd_static_module
# Explicit EMPTY assignments: module configs are sourced sequentially into one
# shell, so omitting these would inherit whatever an earlier-sourced module
# config (e.g. filter/config) left behind — the zstd-free static module would
# silently pick up foreign include paths and link libzstd.
ngx_module_incs=
ngx_module_libs=
ngx_module_srcs=$HTTP_ZSTD_SRCS
# Module-order: zstd_static wins over brotli_static / gzip_static when a
# resource has multiple precompressed sidecars and the client accepts more
# than one encoding. Closes upstream tokers/zstd-nginx-module#40 (mklooss).
#
# ngx_module_order semantics: the first name comes BEFORE the rest in the
# generated ngx_modules[] array. nginx reverses content-phase handlers in
# ngx_http_init_phase_handlers (src/http/ngx_http.c:551) — LIFO chain —
# so a module at a HIGHER ngx_modules[] index has its handler called
# FIRST at request time. To make zstd_static win we therefore need it at
# the END of this list, after every static-module sibling that might
# otherwise outrank it.
ngx_module_order="ngx_http_static_module \
                  ngx_http_gzip_static_module \
                  ngx_http_brotli_static_module \
                  $ngx_module_name"

. auto/module

if [ "$ngx_module_link" != DYNAMIC ]; then
    # ngx_module_order doesn't work with static modules (only honoured for
    # --add-dynamic-module builds), so we must reorder HTTP_MODULES here.
    # Mirror filter/config:131 pattern: pick the next module by precedence
    # so the source-list order ends up as zstd_static before brotli_static
    # / gzip_static — nginx wraps content handlers in LIFO order, so a later
    # source-list entry runs earlier in the runtime chain.
    if echo $HTTP_MODULES | grep ngx_http_brotli_static_module >/dev/null; then
        next=ngx_http_brotli_static_module
    elif echo $HTTP_MODULES | grep ngx_http_gzip_static_module >/dev/null; then
        next=ngx_http_gzip_static_module
    else
        next=ngx_http_static_module
    fi

    HTTP_MODULES=`echo $HTTP_MODULES \
                  | sed "s/$ngx_module_name//" \
                  | sed "s/$next/$next $ngx_module_name/"`
fi
