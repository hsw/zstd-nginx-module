#!/usr/bin/make -f
# debian/rules — build the zstd-nginx-module dynamic modules under debhelper.
#
# Scaffolded by hand following pkg-oss conventions (hg clone unavailable at
# scaffold time). pkg-oss build_module.sh emits a single --add-dynamic-module
# pointing at one module source dir; this tree ships TWO modules (filter and
# static) but shares a single top-level `config` that sources both
# `filter/config` and `static/config`. Therefore we pass ONE
# --add-dynamic-module=$(CURDIR) — repo root — and a single configure+make
# invocation produces BOTH .so artefacts, which dh_install then splits into
# two binary packages (libnginx-mod-http-zstd-filter,
# libnginx-mod-http-zstd-static).
#
# This mirrors t/docker/build-module.sh (the proven test harness path).
# The single root add is the packaging contract: one configure+make pass
# builds both .so artefacts. Per-subdir adds (--add-dynamic-module=
# $(CURDIR)/filter or /static) also work — the configs detect the add
# layout when resolving their source paths — but each would need its own
# configure+make pass, for no benefit here.
#
# To re-scaffold from pkg-oss in the future:
#   hg clone https://hg.nginx.org/pkg-oss && hg -R pkg-oss id
# then run pkg-oss/build_module.sh against this tree and re-apply the
# single-flag-points-at-repo-root configure customisation below.
#
# Build-time env overrides:
#   ZSTD_INC   — additional -I path for libzstd headers (consumed via $(if ...) below).
#                (default: empty; uses /usr/include via libzstd-dev)
#   ZSTD_LIB   — additional -L path for libzstd library (consumed via $(if ...) below).
#                (default: empty; uses /usr/lib via libzstd-dev)
#                Set ZSTD_INC and ZSTD_LIB together or not at all: besides
#                the $(if ...) consumption below, both are inherited by nginx
#                configure as environment variables, and filter/config
#                hard-fails a half-set pair (both-or-none guard).
#   NGINX_SRC  — path to unpacked nginx source tree (consumed via `?=` default below).
#                (default: /usr/local/src/nginx, the symlink set by
#                t/ci/install-nginx-mainline.sh to /usr/local/src/nginx-${VER}/)

# Honour ZSTD_INC / ZSTD_LIB env overrides for cc-opt / ld-opt. Both vars
# are empty in the default libzstd-dev path (CI uses /usr/include + /usr/lib)
# so the --with-*-opt flags are emitted conditionally: passing an empty
# --with-cc-opt="" overrides nginx-dev's default CFLAGS like `-g -O2 -Wformat`,
# stripping hardening flags from the build. The $(if ...) guards drop the
# flags entirely when the override env is unset.
ZSTD_CC_OPT := $(if $(ZSTD_INC),--with-cc-opt=-I$(ZSTD_INC),)
ZSTD_LD_OPT := $(if $(ZSTD_LIB),--with-ld-opt=-L$(ZSTD_LIB),)

NGINX_SRC ?= /usr/local/src/nginx

%:
	dh $@

override_dh_auto_configure:
	# Single --add-dynamic-module pointing at the repo root. The top-level
	# `config` (at $(CURDIR)/config) sources both filter/config and
	# static/config, producing BOTH .so artefacts from one configure+make.
	# See the file header comment for why the single root add is preferred
	# over per-subdir adds.
	cd $(NGINX_SRC) && ./configure \
	    --with-compat \
	    $(ZSTD_CC_OPT) \
	    $(ZSTD_LD_OPT) \
	    --add-dynamic-module=$(CURDIR)

override_dh_auto_build:
	# Builds modules into $(NGINX_SRC)/objs/. The nginx source tarball is
	# unpacked into /usr/local/src/nginx-${VER}/ by
	# t/ci/install-nginx-mainline.sh as root (the CI build user), so this
	# works without an explicit copy. If that ever changes (e.g. building
	# under a non-root user that can't write under /usr/local/src), either
	# copy $(NGINX_SRC) to a private build dir here, or override NGINX_SRC
	# env from the caller.
	$(MAKE) -C $(NGINX_SRC) modules

override_dh_auto_install:
	# Stage .so artefacts into debian/tmp/ so dh_install (driven by the
	# two per-package .install files) can copy them into the per-package
	# staging trees. dh_install resolves source paths RELATIVE to
	# debian/tmp/ (or debian/<pkg>/), not from the host filesystem root —
	# so the .so files cannot be referenced directly at /usr/src/...
	# without first staging them into the package build area.
	install -d $(CURDIR)/debian/tmp/usr/lib/nginx/modules
	install -m 0644 $(NGINX_SRC)/objs/ngx_http_zstd_filter_module.so \
	    $(CURDIR)/debian/tmp/usr/lib/nginx/modules/
	install -m 0644 $(NGINX_SRC)/objs/ngx_http_zstd_static_module.so \
	    $(CURDIR)/debian/tmp/usr/lib/nginx/modules/

override_dh_auto_clean:
	-cd $(NGINX_SRC) && $(MAKE) clean 2>/dev/null || true
	dh_auto_clean
