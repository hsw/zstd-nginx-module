#!/bin/sh
# postinst — the .deb ships the zstd static module .so plus a load_module
# snippet under /usr/share/nginx/modules-available/, but does NOT auto-enable
# it. These packages target nginx.org mainline, whose stock nginx.conf sources
# only mime.types + conf.d/*.conf, so the Debian auto-enable symlink convention
# would silently load nothing here. Instead, mirroring nginx.org's own
# Makefile.module-brotli MODULE_POST convention, on first `configure` we print
# a banner telling the operator to add the module's load_module line to
# /etc/nginx/nginx.conf (main context) and reload nginx.

set -e

if [ "$1" != "configure" ]; then
    exit 0
fi

cat <<'BANNER'
----------------------------------------------------------------------

The nginx zstd static module (ngx_http_zstd_static_module) is now
installed, but not yet enabled.

To enable it, add the following line to the main context of
/etc/nginx/nginx.conf (NOT inside the http { } block):

    load_module modules/ngx_http_zstd_static_module.so;

Then reload nginx:

    nginx -s reload

----------------------------------------------------------------------
BANNER

#DEBHELPER#

exit 0
