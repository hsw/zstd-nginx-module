ngx_feature_incs="#include <zstd.h>"
ngx_feature_test="(void) ZSTD_createCCtx();"
# Compile + link only, never execute the probe binary: the test merely calls
# ZSTD_createCCtx(), so a successful link already proves libzstd is present —
# there is no runtime value to capture. Running it breaks cross-compilation
# (ARM64/RISC-V/s390x on an x86_64 host), where the host cannot execute the
# target binary and configure would wrongly report libzstd absent.
# Adapted from eilandert/zstd-nginx-module ae1ef75.
ngx_feature_run=no

# ZSTD_STATIC_LINKING_ONLY is defined at the include site in
# ngx_http_zstd_filter_module.c (see the comment there); the probe uses only
# the stable API, so the build system carries no -D flags at all.

# auto/feature defines NGX_HAVE_<name> on probe success whenever
# ngx_feature_name is non-empty — clear any value left behind by an
# earlier-sourced addon config so OUR probe doesn't define a foreign macro.
ngx_feature_name=

if [ -n "$ZSTD_INC" ] || [ -n "$ZSTD_LIB" ]; then
    if [ -z "$ZSTD_INC" ] || [ -z "$ZSTD_LIB" ]; then
        # Half-set explicit paths used to expand into dangling -I / -L flags
        # that silently swallowed the next compiler argument; fail fast
        # instead.
        cat << END
            $0: error: ngx_http_zstd_filter_module: \$ZSTD_INC and \$ZSTD_LIB must be set together (got ZSTD_INC="$ZSTD_INC" ZSTD_LIB="$ZSTD_LIB"); set both to the ZStandard include and library directories, or neither for auto-discovery.
END
        exit 1
    fi

    ngx_feature_path="$ZSTD_INC"

    if [ "$ngx_module_link" = DYNAMIC ]; then
        # --add-dynamic-module build: distro libzstd.a is almost never built
        # with -fPIC, so linking it into a .so fails with R_X86_64_PC32
        # relocation errors. Only try the shared library — fail fast if not
        # present rather than silently producing a broken .so.
        ngx_feature="ZStandard dynamic library in $ZSTD_INC and $ZSTD_LIB"
        ngx_feature_libs="-L$ZSTD_LIB -lzstd -Wl,-rpath,$ZSTD_LIB"

        . auto/feature

        if [ $ngx_found = no ]; then
            cat << END
            $0: error: ngx_http_zstd_filter_module (--add-dynamic-module) requires the ZStandard shared library, please be sure that "\$ZSTD_INC" and "\$ZSTD_LIB" are set correctly and that libzstd.so is present.
END
            exit 1
        fi
    else
        # static --add-module build: try the static archive first (so the
        # final nginx binary has no libzstd.so runtime dep), fall back to
        # the shared library.
        ngx_feature="ZStandard static library in $ZSTD_INC and $ZSTD_LIB"
        ngx_feature_libs="$ZSTD_LIB/libzstd.a"

        . auto/feature

        if [ $ngx_found = no ]; then
            # then try the dynamic shared library
            ngx_feature="ZStandard dynamic library in $ZSTD_INC and $ZSTD_LIB"
            ngx_feature_libs="-L$ZSTD_LIB -lzstd -Wl,-rpath,$ZSTD_LIB"

            . auto/feature

            if [ $ngx_found = no ]; then
                cat << END
            $0: error: ngx_http_zstd_filter_module requires the ZStandard library, please be sure that "\$ZSTD_INC" and "\$ZSTD_LIB" are set correctly.
END
                exit 1
            fi
        fi
    fi
else
    # auto-discovery: prefer shared libzstd (required for --add-dynamic-module;
    # static linking of libzstd.a into a .so typically fails without -fPIC
    # archives).
    ngx_feature="ZStandard dynamic library"
    ngx_feature_path=
    ngx_feature_libs="-lzstd"

    . auto/feature

    if [ $ngx_found = no ] && [ "$ngx_module_link" != DYNAMIC ]; then
        # fall back to static archive only for static (--add-module) builds;
        # dynamic modules must link the shared library.
        ngx_feature="ZStandard static library"
        ngx_feature_libs="-l:libzstd.a"

        . auto/feature
    fi

    if [ $ngx_found = no ]; then
        cat << END
        $0: error: ngx_http_zstd_filter_module requires the ZStandard library.
END
        exit 1
    fi

    # TODO we need more tries for the different OS port.
fi

# Capture the winning probe's libs for the module declaration below, then
# clear the probe inputs: auto/feature resets neither ngx_feature_path nor
# ngx_feature_libs, so leftover values would leak into the next sourced
# addon config's probes (same cross-config leakage class as C11-4).
ngx_zstd_libs="$ngx_feature_libs"
ngx_feature_libs=
ngx_feature_path=

# The module source must resolve for BOTH add layouts: sourcing via the root
# config (--add-dynamic-module=<repo>, ngx_addon_dir = repo root) and adding
# this subdirectory directly (--add-dynamic-module=<repo>/filter,
# ngx_addon_dir = .../filter).
if [ -f "$ngx_addon_dir/ngx_http_zstd_filter_module.c" ]; then
    HTTP_ZSTD_SRCS="$ngx_addon_dir/ngx_http_zstd_filter_module.c"
else
    HTTP_ZSTD_SRCS="$ngx_addon_dir/filter/ngx_http_zstd_filter_module.c"
fi

ngx_addon_name=ngx_http_zstd_filter_module
ngx_module_type=HTTP_FILTER
ngx_module_name=ngx_http_zstd_filter_module
# ngx_module_incs takes bare DIRECTORIES only — auto/make rewrites every
# whitespace-separated token to `-I <token>`, so a flag-shaped token (-D, -I,
# -L) would be eaten as the argument of -I. Empty when auto-discovered.
ngx_module_incs="$ZSTD_INC"
ngx_module_srcs=$HTTP_ZSTD_SRCS
# Only OUR link flags — assigning NGX_LD_OPT here used to duplicate the
# operator's entire --with-ld-opt into the module's lib list.
ngx_module_libs="$ngx_zstd_libs"
ngx_module_order="$ngx_module_name \
                  ngx_pagespeed \
                  ngx_http_postpone_filter_module \
                  ngx_http_ssi_filter_module \
                  ngx_http_charset_filter_module \
                  ngx_http_xslt_filter_module \
                  ngx_http_image_filter_module \
                  ngx_http_sub_filter_module \
                  ngx_http_addition_filter_module \
                  ngx_http_gunzip_filter_module \
                  ngx_http_userid_filter_module \
                  ngx_http_headers_filter_module \
                  ngx_http_copy_filter_module \
                  ngx_http_range_body_filter_module \
                  ngx_http_not_modified_filter_module \
                  ngx_http_slice_filter_module"

. auto/module

if [ "$ngx_module_link" != DYNAMIC ]; then
    # ngx_module_order doesn't work with static modules,
    # so we must re-order filters here.

    # Pick insertion target by precedence so the source-list order ends up as
    # (brotli) before zstd before (gzip/pagespeed/range). nginx wraps filters
    # in LIFO order, so a later source-list entry runs earlier in the runtime
    # chain. Result: zstd > br > gzip when all three are present. brotli
    # check must come first — build-module.sh adds ngx_brotli BEFORE the main
    # module, so by the time this sed runs brotli_filter is already in
    # HTTP_FILTER_MODULES and the sed can pin zstd_filter right after it.
    if echo $HTTP_FILTER_MODULES | grep ngx_http_brotli_filter_module >/dev/null; then
        next=ngx_http_brotli_filter_module
    elif [ "$HTTP_GZIP" = YES ]; then
        next=ngx_http_gzip_filter_module
    elif echo $HTTP_FILTER_MODULES | grep pagespeed_etag_filter >/dev/null; then
        next=ngx_pagespeed_etag_filter
    else
        next=ngx_http_range_header_filter_module
    fi

    HTTP_FILTER_MODULES=`echo $HTTP_FILTER_MODULES \
                         | sed "s/$ngx_module_name//" \
                         | sed "s/$next/$next $ngx_module_name/"`
fi
