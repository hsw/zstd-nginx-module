# Dockerfile.asan — AddressSanitizer + UndefinedBehaviorSanitizer variant.
#
# Builds nginx + zstd module with Clang and `-fsanitize=address,undefined`.
# Catches:
#   * heap buffer overflows / use-after-free / double-free (ASan)
#   * signed integer overflow, shift-overflow, null deref, misaligned access (UBSan)
#
# Static build (--add-module, not dynamic) so the sanitizer runtime is linked
# directly into the nginx binary. Reusing the apt-installed dynamic nginx and
# loading a sanitizer-instrumented .so via load_module doesn't work cleanly:
# the host binary lacks ASan and the runtime preload via LD_PRELOAD is fragile.
#
# Usage:
#   bash t/asan.sh                       # build + run full regression suite
#
# ASan/UBSan output appears on nginx's stderr, which the driver tails and
# scans for `==ERROR:` and UBSan `runtime error:` markers.
#
# Adapted from nginx-ssl-fingerprint's asan.Dockerfile (drops OpenSSL build,
# JA patches, stream/http_v2 add-on modules).

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
        clang-18 lld-18 \
        libpcre3-dev libssl-dev zlib1g-dev libzstd-dev \
        make \
        curl ca-certificates \
        gnupg lsb-release \
        bash python3 zstd \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/clang-18 /usr/local/bin/clang \
    && ln -s /usr/bin/clang++-18 /usr/local/bin/clang++ \
    && ln -s /usr/bin/ld.lld-18 /usr/local/bin/ld.lld

# Pin nginx.org mainline (same idiom as the other variants).
RUN curl -fsSL https://nginx.org/keys/nginx_signing.key | gpg --dearmor -o /usr/share/keyrings/nginx-archive-keyring.gpg \
 && CODENAME=$(lsb_release -cs) \
 && echo "deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/mainline/ubuntu/ ${CODENAME} nginx" > /etc/apt/sources.list.d/nginx.list \
 && printf 'Package: *\nPin: origin nginx.org\nPin: release o=nginx\nPin-Priority: 900\n' > /etc/apt/preferences.d/99nginx \
 && apt-get update \
 && apt-get install -y nginx \
 && rm -rf /var/lib/apt/lists/*

RUN NGINX_VERSION=$(/usr/sbin/nginx -v 2>&1 | sed 's|.*nginx/||' | sed 's|[[:space:]].*||') \
 && curl -fsSL "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" -o /tmp/nginx.tar.gz \
 && mkdir -p /usr/local/src \
 && tar -C /usr/local/src -xzf /tmp/nginx.tar.gz \
 && ln -s "/usr/local/src/nginx-${NGINX_VERSION}" /usr/local/src/nginx \
 && rm -f /tmp/nginx.tar.gz

COPY config /src/config
COPY filter /src/filter
COPY static /src/static

# Build nginx with ASan + UBSan. -fno-sanitize=alignment because nginx core
# does some intentionally-unaligned reads (ngx_string.c) that UBSan flags as
# UB but are safe on x86_64/arm64. -fno-omit-frame-pointer makes the stack
# traces actually useful.
#
# ASAN_OPTIONS=detect_leaks=0 during configure: nginx's auto/feature compiles
# and *runs* a tiny ZSTD_createCCtx() probe. Under ASan that leaks the
# returned cctx (which is intentional in the probe — it never frees), so the
# probe exits nonzero and configure thinks libzstd is unavailable. Detection
# only — runtime leaks are still caught (the CMD/runtime env above turns it
# back on).
#
# Single --add-module=/src — the top-level config sources both filter/ and
# static/. Pointing --add-module at a subdir breaks: the inner config scripts
# assume $ngx_addon_dir is the repo root.
RUN cd /usr/local/src/nginx && \
    ASAN_OPTIONS=detect_leaks=0 \
    ./configure \
      --prefix=/usr \
      --conf-path=/etc/nginx/nginx.conf \
      --sbin-path=/usr/sbin/nginx \
      --pid-path=/tmp/nginx.pid \
      --error-log-path=/var/log/nginx/error.log \
      --http-log-path=/var/log/nginx/access.log \
      --modules-path=/etc/nginx/modules \
      --with-cc=clang \
      --with-cc-opt="-O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize=alignment -Wno-error" \
      --with-ld-opt="-fsanitize=address,undefined -fuse-ld=lld" \
      --with-http_ssl_module \
      --add-module=/src \
      2>&1 | tail -10 && \
    make -j"$(nproc)" 2>&1 | tail -5 && \
    install -m 0755 objs/nginx /usr/sbin/nginx && \
    /usr/sbin/nginx -V 2>&1

RUN mkdir -p /var/fixtures/random /tmp/client_body /tmp/proxy /tmp/fastcgi /tmp/uwsgi /tmp/scgi /var/log/nginx

COPY t/docker/nginx.conf.template /etc/nginx/templates/nginx.conf.template
COPY t/regression /opt/regression

RUN sed \
        -e 's|__LOAD_MODULES__||' \
        -e 's|__EXTRA_DIRECTIVES__||' \
        -e 's|__EXTRA_LOCATIONS__||' \
        -e 's|__SERVER_PORT__|8080|' \
        /etc/nginx/templates/nginx.conf.template > /etc/nginx/nginx.conf

# Sanitizer runtime tuning:
#   detect_leaks=0     — nginx allocates pools on startup that it never
#                        explicitly frees (cycle pool, log pool); on a clean
#                        exit ASan reports those as leaks. They are *not*
#                        bugs — they're the standard "free everything when
#                        the process dies" pattern.
#   abort_on_error=0   — don't abort the process on a finding; we want nginx
#                        to keep serving so the next request can still hit
#                        it (and surface more findings).
#   exitcode=0         — every UBSan finding under nginx ends up exiting the
#                        worker, which the master then respawns indefinitely.
#                        nginx core has a long-known UB (function-pointer
#                        cast through void*-ctx in ngx_output_chain.c:70)
#                        that fires on every request; with exitcode!=0
#                        workers die in a respawn loop. Setting it to 0
#                        lets the worker continue. The driver still detects
#                        findings by grepping log output for `runtime error:`
#                        and `==ERROR:`.
ENV ASAN_OPTIONS=detect_leaks=0:abort_on_error=0:exitcode=0:halt_on_error=0:strict_string_checks=1:check_initialization_order=1:print_stacktrace=1
ENV UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=0:exitcode=0

EXPOSE 8080

# nginx.conf.template already includes `daemon off;` — don't pass -g for it
# (duplicate-directive error). The template's daemon-off ensures the binary
# runs PID 1.
CMD ["/usr/sbin/nginx"]
