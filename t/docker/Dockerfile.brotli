# Dockerfile.brotli — STATIC build that links ngx_brotli and this module into
# a fresh nginx binary. Exercises Task 8's filter-priority sed (brotli > zstd
# > gzip ordering in HTTP_FILTER_MODULES) and the precedence regression in
# t/regression/filter-priority.sh.
#
# Single-stage on purpose; the static nginx replaces the apt-installed
# /usr/sbin/nginx so the rest of the image still uses the standard path.

ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive

# build deps + ngx_brotli build deps (git, cmake, g++ for the submodule's
# brotli encoder/decoder cmake project). Runtime libs (libpcre2-8, libssl3,
# libbrotli1, libzstd1, zlib1g) are pulled transitively by the -dev packages
# above, so we don't list them separately.
RUN apt-get update \
 && apt-get install -y \
        curl ca-certificates gnupg lsb-release \
        build-essential libpcre2-dev libssl-dev zlib1g-dev libzstd-dev libbrotli-dev \
        zstd python3 python3-venv python3-pip wget pkg-config git cmake g++ \
 && curl -fsSL https://nginx.org/keys/nginx_signing.key | gpg --dearmor -o /usr/share/keyrings/nginx-archive-keyring.gpg \
 && CODENAME=$(lsb_release -cs) \
 && echo "deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/mainline/ubuntu/ ${CODENAME} nginx" > /etc/apt/sources.list.d/nginx.list \
 && printf 'Package: *\nPin: origin nginx.org\nPin: release o=nginx\nPin-Priority: 900\n' > /etc/apt/preferences.d/99nginx \
 && apt-get update && apt-get install -y nginx \
 && rm -rf /var/lib/apt/lists/*

# Even though our runtime nginx is a static build, we still install nginx
# from nginx.org in order to discover the canonical upstream version and
# download the matching source tarball — keeps the brotli variant on the
# same nginx tree as the dynamic variants.
RUN NGINX_VERSION=$(/usr/sbin/nginx -v 2>&1 | sed 's|.*nginx/||' | sed 's|[[:space:]].*||') \
 && curl -fsSL "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" -o /tmp/nginx.tar.gz \
 && mkdir -p /usr/local/src \
 && tar -C /usr/local/src -xzf /tmp/nginx.tar.gz \
 && ln -s "/usr/local/src/nginx-${NGINX_VERSION}" /usr/local/src/nginx \
 && rm -f /tmp/nginx.tar.gz

# Pin ngx_brotli to a ref for reproducibility (default master; override at
# build time with --build-arg NGX_BROTLI_REF=...). The submodules pull in the
# google/brotli C library sources used by the encoder.
ARG NGX_BROTLI_REF=master
RUN git clone --recurse-submodules --depth 1 --branch "${NGX_BROTLI_REF}" \
        https://github.com/google/ngx_brotli.git /src/ngx_brotli

COPY config /src/zstd-nginx-module/config
COPY filter /src/zstd-nginx-module/filter
COPY static /src/zstd-nginx-module/static
COPY t/docker/build-module.sh /src/zstd-nginx-module/t/docker/build-module.sh
# Static build links brotli + zstd into a single nginx binary. The third
# positional arg "static" selects --add-module + `make` (no --with-compat).
RUN /src/zstd-nginx-module/t/docker/build-module.sh \
        /usr/local/src/nginx \
        /src/zstd-nginx-module \
        static \
        /src/ngx_brotli \
 && install -m 0755 /usr/local/src/nginx/objs/nginx /usr/sbin/nginx

RUN mkdir -p /etc/nginx /etc/nginx/modules /var/log/nginx /var/cache/nginx \
             /var/fixtures/random /tmp/client_body /tmp/proxy /tmp/fastcgi /tmp/uwsgi /tmp/scgi

# Pinned Python test deps in a venv — placed after nginx build so test-dep
# changes don't invalidate the build cache. See Dockerfile.dynamic.
COPY t/docker/requirements.txt /opt/requirements.txt
RUN python3 -m venv /opt/test-venv \
 && /opt/test-venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/test-venv/bin/pip install --no-cache-dir -r /opt/requirements.txt
ENV PATH=/opt/test-venv/bin:$PATH

COPY t/docker/nginx.conf.template /etc/nginx/templates/nginx.conf.template
COPY t/regression /opt/regression

# Static build: no `load_module` lines. Brotli is enabled inline so the
# default config is meaningful even before regression-specific re-rendering.
RUN sed \
        -e 's|__LOAD_MODULES__||' \
        -e 's|__EXTRA_DIRECTIVES__|brotli on; brotli_min_length 0; brotli_types *;|' \
        -e 's|__EXTRA_SERVER__||' \
        -e 's|__EXTRA_LOCATIONS__||' \
        -e 's|__SERVER_PORT__|8080|' \
        /etc/nginx/templates/nginx.conf.template > /etc/nginx/nginx.conf

EXPOSE 8080
# Static-build nginx was configured with prefix /usr, conf-path /etc/nginx —
# pass -c explicitly to keep the runtime layout matched with the other
# variants regardless of whether configure's defaults change upstream.
CMD ["nginx", "-c", "/etc/nginx/nginx.conf"]
