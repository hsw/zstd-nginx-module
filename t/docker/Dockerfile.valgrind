# Dockerfile.valgrind — Valgrind memcheck variant for zstd-nginx-module.
#
# Builds nginx + zstd module statically (no dynamic .so loading) with
# `-O0 -g -fno-omit-frame-pointer`. The image bundles valgrind, the
# regression scripts, the rendered nginx.conf, and a suppression file.
#
# Usage from host:
#   bash t/valgrind.sh                  # build + run accept-encoding + dict-reload under valgrind
#
# The driver `t/valgrind.sh` invokes the regression scripts inside this
# container. Valgrind output goes to stderr; the driver greps for "definitely
# lost" / "indirectly lost" and reports nonzero on findings.
#
# Adapted from nginx-ssl-fingerprint's valgrind.Dockerfile:
#   * Drops OpenSSL build / cert generation (zstd module needs no SSL).
#   * Statically links the module (--add-module, not --add-dynamic-module) so
#     valgrind sees ngx_http_zstd_filter_module symbols in the main binary's
#     symbol table without dlopen indirection.
#   * Mounts regression scripts at /opt/regression to match the runtime variants.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
        gcc \
        valgrind \
        libpcre2-dev libssl-dev zlib1g-dev libzstd-dev \
        make \
        curl ca-certificates \
        gnupg lsb-release \
        bash python3 python3-pytest python3-requests python3-zstandard python3-websockets zstd \
    && rm -rf /var/lib/apt/lists/*

# Pin to nginx.org mainline via the apt package, then fetch matching tarball.
# Same idiom as the runtime variants.
RUN curl -fsSL https://nginx.org/keys/nginx_signing.key | gpg --dearmor -o /usr/share/keyrings/nginx-archive-keyring.gpg \
 && CODENAME=$(lsb_release -cs) \
 && echo "deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/mainline/ubuntu/ ${CODENAME} nginx" > /etc/apt/sources.list.d/nginx.list \
 && printf 'Package: *\nPin: origin nginx.org\nPin: release o=nginx\nPin-Priority: 900\n' > /etc/apt/preferences.d/99nginx \
 && apt-get update \
 && apt-get install -y nginx \
 && rm -rf /var/lib/apt/lists/*

RUN NGINX_VERSION=$(/usr/sbin/nginx -v 2>&1 | sed 's|.*nginx/||' | sed 's|[[:space:]].*||') \
 && curl -fsSL "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" -o /tmp/nginx.tar.gz \
 && mkdir -p /usr/local/src \
 && tar -C /usr/local/src -xzf /tmp/nginx.tar.gz \
 && ln -s "/usr/local/src/nginx-${NGINX_VERSION}" /usr/local/src/nginx \
 && rm -f /tmp/nginx.tar.gz

COPY config /src/config
COPY filter /src/filter
COPY static /src/static

# Static build with debug flags. Output is /usr/local/src/nginx/objs/nginx
# (we move it to /usr/sbin/nginx to override the apt-installed binary so the
# regression scripts find it on PATH transparently).
#
# Single --add-module=/src — the top-level config sources both filter/ and
# static/. Pointing --add-module at a subdir breaks: the inner config scripts
# assume $ngx_addon_dir is the repo root.
RUN cd /usr/local/src/nginx && \
    ./configure \
      --prefix=/usr \
      --conf-path=/etc/nginx/nginx.conf \
      --sbin-path=/usr/sbin/nginx \
      --pid-path=/tmp/nginx.pid \
      --error-log-path=/var/log/nginx/error.log \
      --http-log-path=/var/log/nginx/access.log \
      --modules-path=/etc/nginx/modules \
      --with-cc-opt="-O0 -g -fno-omit-frame-pointer -Wno-error" \
      --with-http_ssl_module \
      --add-module=/src \
      2>&1 | tail -10 && \
    make -j"$(nproc)" 2>&1 | tail -5 && \
    install -m 0755 objs/nginx /usr/sbin/nginx && \
    /usr/sbin/nginx -V 2>&1

RUN mkdir -p /var/fixtures/random /tmp/client_body /tmp/proxy /tmp/fastcgi /tmp/uwsgi /tmp/scgi /var/log/nginx

COPY t/docker/nginx.conf.template /etc/nginx/templates/nginx.conf.template
COPY t/docker/valgrind.supp /etc/valgrind.supp
COPY t/regression /opt/regression

# Render a baseline nginx.conf (static build → no load_module line). Drivers
# may re-render it from /etc/nginx/templates/nginx.conf.template per-test.
RUN sed \
        -e 's|__LOAD_MODULES__||' \
        -e 's|__EXTRA_DIRECTIVES__||' \
        -e 's|__EXTRA_LOCATIONS__||' \
        -e 's|__SERVER_PORT__|8080|' \
        /etc/nginx/templates/nginx.conf.template > /etc/nginx/nginx.conf

EXPOSE 8080

# Default CMD: smoke valgrind on nginx -t. The driver `t/valgrind.sh`
# overrides this to run the regression scripts under valgrind instead.
CMD ["valgrind", \
     "--tool=memcheck", \
     "--leak-check=full", \
     "--show-leak-kinds=definite,indirect", \
     "--track-origins=yes", \
     "--error-exitcode=99", \
     "--suppressions=/etc/valgrind.supp", \
     "/usr/sbin/nginx", "-t", "-c", "/etc/nginx/nginx.conf"]
