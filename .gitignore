**/__pycache__/
*.pyc
.pytest_cache/

# Test harness runtime output — all drivers write under tmp/
tmp/

# Local working notes (decisions, drafts, comparison reports, etc.).
# Anything under docs/ is for the working copy only — not shared via git.
docs/

# macOS
.DS_Store

# debhelper build turds — generated under debian/ during dpkg-buildpackage.
# debian/changelog is generated per build via `dch -v` and never committed.
# debian/control is generated by debian/prepare.sh from control.in.
debian/files
debian/.debhelper/
debian/*.substvars
debian/*.debhelper.log
debian/debhelper-build-stamp
debian/libnginx-mod-http-zstd-filter/
debian/libnginx-mod-http-zstd-static/
debian/changelog
debian/control
